{
    "name": "typed-screeps-arena",
    "version": "0.0.1",
    "description": "Strong TypeScript declarations for the game Screeps:Arena",
    "repository": "screepers/typed-screeps-arena",
    "types": "dist/index.d.ts",
    "files": [
        "dist/**/*.d.ts",
        "index.d.ts"
    ],
    "scripts": {
        "compile:dts": "node ./build/concat.js && node ./build/prependHeader.js",
        "compile": "npm run compile:dts && node ./build/prependDescription.js",
        "format": "prettier --write --ignore-unknown --ignore-path .gitignore '**/*'",
        "lint": "tslint -p tsconfig.json 'src/**/*.ts'",
        "lint:test": "tslint -p dist/tsconfig.json 'dist/screeps-arena-tests.ts'",
        "pre-commit": "npm run compile && git add dist/index.d.ts",
        "prepare": "npm test",
        "tsd": "tsd",
        "test": "npm run compile && npm run tsd"
    },
    "keywords": [
        "Screeps",
        "Screeps Arena",
        "API",
        "Typescript",
        "Autocomplete"
    ],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@types/screeps-arena": "^1.0.1",
        "concat-files": "^0.1.1",
        "copy": "^0.3.2",
        "husky": "^2.2.0",
        "lint-staged": "^8.1.6",
        "prepend": "^1.0.2",
        "prettier": "^2.6.2",
        "rimraf": "^2.6.2",
        "tsd": "^0.31.0",
        "tslint": "^5.12.0",
        "tslint-config-prettier": "^1.17.0",
        "tslint-plugin-prettier": "^2.0.1",
        "typescript": "^4.6.3"
    },
    "dependencies": {
        "yarn": "^1.22.22"
    }
}
